{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gen:types": "openapi-typescript http://localhost:8000/openapi.json -o shared/types/api.gen.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.1",
    "@nuxtjs/i18n": "^10.1.1",
    "@pinia/colada": "^1.3.0",
    "@pinia/nuxt": "^0.11.2",
    "@vueuse/core": "^13.9.0",
    "@vueuse/router": "^14.3.0",
    "dayjs": "^1.11.18",
    "nuxt": "^4.1.3",
    "slugify": "^1.6.9",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.107",
    "@iconify-json/simple-icons": "^1.2.82",
    "@intlify/eslint-plugin-vue-i18n": "^4.4.0",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "axe-core": "^4.11.4",
    "eslint": "^9.39.4",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "openapi-typescript": "~7.13.0",
    "pg": "^8.13.1",
    "playwright-core": "^1.59.1",
    "tsx": "^4.20.6",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{vue,ts,js,mjs}": "eslint --fix",
    "i18n/locales/**/*.json": "eslint --fix"
  }
}
