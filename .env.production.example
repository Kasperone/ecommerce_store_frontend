# Nuxt frontend — production runtime env (template; copy to the platform's env, not committed).
#
# The Docker image is environment-agnostic: Nuxt reads `runtimeConfig.public.apiBase`
# from NUXT_PUBLIC_API_BASE at server start, so set it per environment here.

# Public base URL of the backend API (used by useApi / SSR fetches).
NUXT_PUBLIC_API_BASE=https://api.your-domain.com

# Server-only shared secret for the backend's SSR session-validation endpoint
# (POST /auth/refresh/ssr). MUST MATCH the backend's SSR_SHARED_SECRET. The SSR
# auth restore sends it as the X-SSR-Secret header to mint an access token
# WITHOUT rotating the refresh cookie. REQUIRED in production: if left empty,
# every SSR cold load (hard reload, bookmarked link, new tab) falls back to the
# rotating, IP-rate-limited POST /auth/refresh (30/hour, shared across all users
# behind one SSR origin IP) — exhausting it logs users out.
NUXT_SSR_SHARED_SECRET=change-me-to-match-backend-SSR_SHARED_SECRET

# Server bind — defaults are baked into the Dockerfile; override only if the
# platform requires a different port/host.
# HOST=0.0.0.0
# PORT=3000
