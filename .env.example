# API Base URL
NUXT_PUBLIC_API_BASE=http://localhost:8000

# App Configuration
NUXT_PUBLIC_APP_NAME="E-commerce Store"

# Server-only shared secret for the backend's SSR session-validation endpoint
# (POST /auth/refresh/ssr). Must MATCH the backend's SSR_SHARED_SECRET. The SSR
# auth restore sends it as the X-SSR-Secret header to mint an access token
# WITHOUT rotating the refresh cookie (fixes the hard-reload hydration mismatch).
# Leave empty to fall back to the legacy rotating /auth/refresh on SSR.
NUXT_SSR_SHARED_SECRET=

# --- Google Analytics 4 + Google Ads (Pillars B–D) ---------------------------
# All four are PUBLIC (gtag/Ads/Merchant IDs ship to the client; not secret).
# Leave EVERY value empty to keep the analytics/ads tags fully no-op — nothing
# loads, no events fire, the app behaves exactly as without analytics. Populate
# them per the Phase-0 external account setup (GA4 property, Ads conversion
# action, Merchant Center) to switch the tags on.
#
# GA4 measurement id (e.g. G-XXXXXXXX). Empty => no GA4 tag, no ecommerce events.
NUXT_PUBLIC_GA4_ID=
# Google Ads conversion id (e.g. AW-XXXXXXXXX). Empty => no Ads conversion/remarketing.
NUXT_PUBLIC_ADS_ID=
# The Ads "Purchase" conversion-action label (the string after the slash in
# send_to: AW-XXXXXXXXX/AbC-D_efG...). Required for the Ads purchase conversion.
NUXT_PUBLIC_ADS_PURCHASE_LABEL=
# Merchant Center account id — attached as aw_merchant_id on the purchase
# conversion so Ads can join conversions to feed products (Shopping/PMax).
NUXT_PUBLIC_MERCHANT_ID=
