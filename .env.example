# API Base URL
NUXT_PUBLIC_API_BASE=http://localhost:8000

# App Configuration
NUXT_PUBLIC_APP_NAME="E-commerce Store"

# Server-only shared secret for the backend's SSR session-validation endpoint
# (POST /auth/refresh/ssr). Must MATCH the backend's SSR_SHARED_SECRET. The SSR
# auth restore sends it as the X-SSR-Secret header to mint an access token
# WITHOUT rotating the refresh cookie (fixes the hard-reload hydration mismatch).
# Leave empty to fall back to the legacy rotating /auth/refresh on SSR.
NUXT_SSR_SHARED_SECRET=
